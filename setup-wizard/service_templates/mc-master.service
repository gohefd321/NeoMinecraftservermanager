[Unit]
Description=NextGen MC Hosting Master Control Plane Daemon
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/nextgen-mc-platform/backend
EnvironmentFile=-/etc/nextgen-mc/node.env
Environment=PYTHONPATH=/opt/nextgen-mc-platform/backend
Environment=PORT=8005
Environment=MASTER_PORT=8005
# Uvicorn 8005 Master Daemon
ExecStart=/bin/bash -c 'PORT_VAL=${MASTER_PORT:-8005}; if [ -d /opt/nextgen-mc-platform/backend ]; then cd /opt/nextgen-mc-platform/backend; elif [ -d /home/bettercallsixseven/nextgen-mc-platform/backend ]; then cd /home/bettercallsixseven/nextgen-mc-platform/backend; fi; if [ -f /opt/nextgen-mc-platform/venv/bin/uvicorn ]; then exec /opt/nextgen-mc-platform/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port $PORT_VAL --workers 2; elif command -v uvicorn &>/dev/null; then exec uvicorn app.main:app --host 0.0.0.0 --port $PORT_VAL --workers 2; else exec python3 -m uvicorn app.main:app --host 0.0.0.0 --port $PORT_VAL --workers 2; fi'
Restart=always
RestartSec=3s
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
