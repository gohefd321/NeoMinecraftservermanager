[Unit]
Description=NextGen MC Hosting Worker Node Agent
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/nextgen-mc-platform/worker
EnvironmentFile=-/etc/nextgen-mc/node.env
ExecStart=/bin/bash -c 'if [ -f /opt/nextgen-mc-platform/venv/bin/python3 ]; then exec /opt/nextgen-mc-platform/venv/bin/python3 agent.py; else exec python3 agent.py; fi'
Restart=always
RestartSec=5s
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
